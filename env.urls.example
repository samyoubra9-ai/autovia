# =============================================================================
# URLs Autovia — de préférence : PUBLIC_HOST dans autoecole/.env puis npm run env:sync
# =============================================================================
#
# autoecole/.env :
#   PUBLIC_HOST=192.168.43.157
#   PUBLIC_SCHEME=http
#   npm run env:sync
#
#
# 1) autoecole/.env          → variables NEXT_PUBLIC_* + CORS_* ci-dessous
# 2) backdash/.env           → bloc VITE_* (mêmes URLs)
# 3) candidat/.env           → bloc VITE_* (mêmes URLs)
# 4) platform-admin/.env     → bloc VITE_* (mêmes URLs)
#
# Supabase Auth → Site URL = URL BACKDASH, Redirect URLs = BACKDASH/auth/callback
#                 + PLATFORM_ADMIN/auth/callback (+ CANDIDAT si auth un jour)
# =============================================================================

# --- Next.js (racine) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Backdash : boutons Connexion / Démarrer sur la landing → {BACKDASH_URL}/sign-in
NEXT_PUBLIC_BACKDASH_URL=http://localhost:5173
NEXT_PUBLIC_CANDIDAT_URL=http://localhost:5174
NEXT_PUBLIC_PLATFORM_ADMIN_URL=http://localhost:5175
# Optionnel : chemins backdash si différents (défaut /sign-in et /sign-up)
# NEXT_PUBLIC_BACKDASH_SIGN_IN_PATH=/sign-in
# NEXT_PUBLIC_BACKDASH_SIGN_UP_PATH=/sign-up

# CORS API : origines en plus (virgules), ex. https://www.mondomaine.dz
CORS_EXTRA_ORIGINS=

# Dev mobile Wi‑Fi (192.168.x.x) : true en dev, false ou vide en production
ALLOW_DEV_LAN_ORIGINS=true

# --- Apps Vite (backdash, candidat, platform-admin) — mêmes hôtes ---
VITE_APP_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000
VITE_BACKDASH_URL=http://localhost:5173
VITE_CANDIDAT_URL=http://localhost:5174
VITE_PLATFORM_ADMIN_URL=http://localhost:5175
# Alias marketing (liens « site ») = VITE_APP_URL
VITE_PLATFORM_URL=http://localhost:3000

# Candidat uniquement : proxy Vite /api en dev (vide = utilise VITE_APP_URL)
VITE_API_PROXY=
