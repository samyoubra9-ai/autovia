// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ——— SaaS & comptes ———

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SubscriptionPlan {
  ESSENTIEL
  ESSENTIEL_CONNECT
  PRO
  ELITE
}

enum VerificationStatus {
  PENDING_DOCUMENTS
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum VerificationDocumentKind {
  AGREMENT
  IDENTITE
}

enum BillingPeriod {
  ANNUAL
  MONTHLY
  TRIAL
  COMPLIMENTARY
  CUSTOM
}

enum UserRole {
  OWNER
  ADMIN
  CASHIER
}

/// Propriétaire de la plateforme (hors tenant auto-école)
model SiteAdmin {
  id             String   @id @default(cuid())
  supabaseUserId String   @unique @map("supabase_user_id")
  email          String   @unique
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  auditLogs                  SiteAdminAuditLog[]
  subscriptionBillingRecords SubscriptionBillingRecord[]

  @@map("site_admins")
}

model SiteAdminAuditLog {
  id          String    @id @default(cuid())
  siteAdminId String?   @map("site_admin_id")
  autoEcoleId String    @map("auto_ecole_id")
  action      String
  detail      String?
  createdAt   DateTime  @default(now()) @map("created_at")

  siteAdmin SiteAdmin? @relation(fields: [siteAdminId], references: [id], onDelete: SetNull)
  autoEcole AutoEcole  @relation(fields: [autoEcoleId], references: [id], onDelete: Cascade)

  @@index([autoEcoleId, createdAt(sort: Desc)])
  @@map("site_admin_audit_logs")
}

model AutoEcole {
  id                 String             @id @default(cuid())
  nom                String
  slug               String             @unique
  ville              String?
  telephone          String?
  emailContact       String?            @map("email_contact")
  /// Impression officielle (liste examen + bordereau) — saisie unique
  wilaya             String?
  nomAr              String?            @map("nom_ar")
  adresseMagasin     String?            @map("adresse_magasin")
  numeroRegistre     String?            @map("numero_registre")
  centreExamenDefaut String?            @map("centre_examen_defaut")
  lieuRedaction      String?            @map("lieu_redaction")
  referenceEnvoi     String?            @map("reference_envoi")
  /// Règles listes d'examen (paramétrables par auto-école)
  listeAgeMinCirculation       Int     @default(18) @map("liste_age_min_circulation")
  listeNatureCodeActive        Boolean @default(true) @map("liste_nature_code_active")
  listeNatureCreneauActive     Boolean @default(true) @map("liste_nature_creneau_active")
  listeNatureCirculationActive Boolean @default(true) @map("liste_nature_circulation_active")
  subscriptionStatus SubscriptionStatus @default(EXPIRED) @map("subscription_status")
  subscriptionPlan   SubscriptionPlan?    @map("subscription_plan")
  maxElevesOverride  Int?                 @map("max_eleves_override")
  verificationStatus VerificationStatus   @default(APPROVED) @map("verification_status")
  verificationRejectionReason String?       @map("verification_rejection_reason")
  verificationReviewedAt      DateTime?     @map("verification_reviewed_at")
  verificationDocumentsPurgedAt DateTime?   @map("verification_documents_purged_at")
  trialEndsAt        DateTime             @map("trial_ends_at")
  paidUntil          DateTime?          @map("paid_until")
  adminNotes         String?            @map("admin_notes")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  users                    User[]
  backdashPushSubscriptions BackdashPushSubscription[]
  eleves        Eleve[]
  moniteurs     Moniteur[]
  vehicules     Vehicule[]
  paiements     Paiement[]
  seancesExamen SeanceExamen[]
  candidatEngagements CandidatEngagement[]
  listesExamen       ListeExamen[]
  categoriesPermis   CategoriePermisEcole[]
  adminAuditLogs             SiteAdminAuditLog[]
  subscriptionBillingRecords SubscriptionBillingRecord[]
  verificationDocuments      AutoEcoleVerificationDocument[]

  @@map("auto_ecoles")
}

model AutoEcoleVerificationDocument {
  id          String                   @id @default(cuid())
  autoEcoleId String                   @map("auto_ecole_id")
  kind        VerificationDocumentKind
  storagePath String                   @map("storage_path")
  fileName    String                   @map("file_name")
  mimeType    String                   @map("mime_type")
  sizeBytes   Int                      @map("size_bytes")
  uploadedAt  DateTime                 @default(now()) @map("uploaded_at")

  autoEcole AutoEcole @relation(fields: [autoEcoleId], references: [id], onDelete: Cascade)

  @@unique([autoEcoleId, kind])
  @@index([autoEcoleId])
  @@map("auto_ecole_verification_documents")
}

model SubscriptionBillingRecord {
  id               String            @id @default(cuid())
  autoEcoleId      String            @map("auto_ecole_id")
  siteAdminId      String?           @map("site_admin_id")
  subscriptionPlan SubscriptionPlan? @map("subscription_plan")
  amountDzd        Int?              @map("amount_dzd")
  billingPeriod    BillingPeriod     @map("billing_period")
  paidUntil        DateTime?         @map("paid_until") @db.Date
  reference        String?
  notes            String?
  accessAction     String            @map("access_action")
  createdAt        DateTime          @default(now()) @map("created_at")

  autoEcole AutoEcole  @relation(fields: [autoEcoleId], references: [id], onDelete: Cascade)
  siteAdmin SiteAdmin? @relation(fields: [siteAdminId], references: [id], onDelete: SetNull)

  @@index([autoEcoleId, createdAt(sort: Desc)])
  @@map("subscription_billing_records")
}

model User {
  id             String   @id @default(cuid())
  supabaseUserId String   @unique @map("supabase_user_id")
  autoEcoleId    String   @map("auto_ecole_id")
  email          String
  prenom         String
  nom            String
  role           UserRole @default(OWNER)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  autoEcole            AutoEcole  @relation(fields: [autoEcoleId], references: [id], onDelete: Cascade)
  paiementsEnregistres Paiement[] @relation("PaiementEnregistrePar")
  pushSubscriptions    BackdashPushSubscription[]

  @@index([autoEcoleId])
  @@map("users")
}

/// Abonnement Web Push — app backdash PWA (personnel auto-école)
model BackdashPushSubscription {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  autoEcoleId String   @map("auto_ecole_id")
  endpoint    String   @unique
  p256dh      String   @map("p256dh")
  auth        String
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  autoEcole AutoEcole @relation(fields: [autoEcoleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([autoEcoleId])
  @@map("backdash_push_subscriptions")
}

// ——— Métier auto-école ———

enum Sexe {
  masculin
  feminin
}

enum GroupeSanguin {
  A_POS  @map("A+")
  A_NEG  @map("A-")
  B_POS  @map("B+")
  B_NEG  @map("B-")
  AB_POS @map("AB+")
  AB_NEG @map("AB-")
  O_POS  @map("O+")
  O_NEG  @map("O-")
}

enum StatutFormation {
  code
  creneau
  circulation
  valide
}

/// Inscription en ligne — EN_ATTENTE jusqu'à validation par l'auto-école.
enum StatutInscription {
  EN_ATTENTE
  VALIDE
  REFUSE
}

enum SeanceStatut {
  planifie
  passe
  annule
  absent
}

enum SeanceType {
  code
  creneau
  circulation
  examen
}

enum SituationFamiliale {
  celibataire
  marie
  divorce
  veuf
}

enum SituationProfessionnelle {
  etudiant
  employe
  sans_emploi
  fonctionnaire
  commercant
  autre
}

enum ListeExamenStatut {
  brouillon
  validee
}

enum CandidatEngagementType {
  seance
  examen

  @@map("candidat_engagement_type")
}

enum CandidatEngagementStatut {
  en_attente
  accepte
  refuse

  @@map("candidat_engagement_statut")
}

enum NatureExamenListe {
  code
  creneau
  circulation
}

/// Catégories de permis définies par chaque auto-école (libellés FR + AR, section liste indépendante)
model CategoriePermisEcole {
  id             String   @id @default(cuid())
  autoEcoleId    String   @map("auto_ecole_id")
  /// Code court unique par école (ex. A, B, A1, C)
  code           String
  libelleFr      String   @map("libelle_fr")
  libelleAr      String?  @map("libelle_ar")
  /// Nombre de lignes sur la liste d'examen officielle pour cette catégorie
  placesListe    Int      @default(10) @map("places_liste")
  /// Afficher une section sur la liste d'examen (impression)
  surListeExamen Boolean  @default(true) @map("sur_liste_examen")
  /// Tarif forfait permis pour cette catégorie (DZD)
  prixPermis     Int      @default(25000) @map("prix_permis")
  ordre          Int      @default(0)
  actif          Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  autoEcole            AutoEcole                       @relation(fields: [autoEcoleId], references: [id], onDelete: Cascade)
  eleves               Eleve[]
  listeExamenCandidats ListeExamenCandidat[]
  listeExamenMessages  ListeExamenMessageCategorie[]
  moniteurs            Moniteur[]
  moniteursCategories  MoniteurCategoriePermis[]

  @@unique([autoEcoleId, code])
  @@index([autoEcoleId])
  @@map("categories_permis")
}

model Eleve {
  id                       String                   @id @default(cuid())
  autoEcoleId              String                   @map("auto_ecole_id")
  identifiant              String
  telephone                String
  nom                      String
  prenom                   String
  nin                      String
  dateNaissance            DateTime                 @map("date_naissance")
  lieuNaissance            String                   @map("lieu_naissance")
  /// Adresse de domicile du candidat
  domicile                 String?
  sexe                     Sexe
  groupeSanguin            GroupeSanguin            @map("groupe_sanguin")
  categoriePermisId        String                   @map("categorie_permis_id")
  statutFormation          StatutFormation          @map("statut_formation")
  statutInscription        StatutInscription        @default(VALIDE) @map("statut_inscription")
  inscriptionRefusedReason String?                  @map("inscription_refused_reason")
  inscriptionValidatedAt   DateTime?                @map("inscription_validated_at")
  mairieEnregistrement     String?                  @map("mairie_enregistrement")
  nationalite              String
  prenomPere               String?                  @map("prenom_pere")
  nomMere                  String?                  @map("nom_mere")
  prenomMere               String?                  @map("prenom_mere")
  /// Nom de jeune fille (optionnel, candidatures féminines)
  nomJeuneFille            String?                  @map("nom_jeune_fille")
  situationFamiliale       SituationFamiliale       @map("situation_familiale")
  /// Valeur prédéfinie (etudiant, employe…) ou texte libre si « autre »
  situationProfessionnelle String                   @map("situation_professionnelle")
  prixPermis               Int                      @default(25000) @map("prix_permis")
  etapeCodeValidee         Boolean                  @default(false) @map("etape_code_validee")
  etapeCreneauValidee      Boolean                  @default(false) @map("etape_creneau_validee")
  etapeCirculationValidee  Boolean                  @default(false) @map("etape_circulation_validee")
  etapeExamenValidee       Boolean                  @default(false) @map("etape_examen_validee")
  codeSuivi                String?                  @unique @map("code_suivi")
  numeroDossier            String?                  @map("numero_dossier")
  /// Date de dépôt du dossier à la DWSR (optionnel)
  dateDepotDwsr            DateTime?                @map("date_depot_dwsr") @db.Date
  nomAr                    String?                  @map("nom_ar")
  prenomAr                 String?                  @map("prenom_ar")
  /// Chemin Supabase Storage : {autoEcoleId}/{eleveId}/photo.{ext}
  photoPath                String?                  @map("photo_path")
  /// Candidat possédant déjà un permis (nouvelle catégorie visée)
  permisDejaObtenu         Boolean                  @default(false) @map("permis_deja_obtenu")
  numeroPermisObtenu       String?                  @map("numero_permis_obtenu")
  datePermisObtenu         DateTime?                @map("date_permis_obtenu") @db.Date
  categoriesPermisObtenues String[]                 @default([]) @map("categories_permis_obtenues")
  /// Mairie ou autorité ayant délivré le permis déjà obtenu (saisie libre)
  permisDelivrePar         String?                  @map("permis_delivre_par")
  moniteurId               String?                  @map("moniteur_id")
  vehiculeId               String?                  @map("vehicule_id")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")

  autoEcole              AutoEcole                @relation(fields: [autoEcoleId], references: [id], onDelete: Cascade)
  categoriePermis        CategoriePermisEcole     @relation(fields: [categoriePermisId], references: [id], onDelete: Restrict)
  moniteur               Moniteur?                @relation(fields: [moniteurId], references: [id], onDelete: SetNull)
  vehicule               Vehicule?                @relation(fields: [vehiculeId], references: [id], onDelete: SetNull)
  paiements              Paiement[]
  seancesExamen          SeanceExamen[]
  listeExamenCandidats   ListeExamenCandidat[]
  candidatEngagements    CandidatEngagement[]
  pushSubscriptions      CandidatPushSubscription[]

  @@unique([autoEcoleId, identifiant])
  @@unique([autoEcoleId, numeroDossier])
  @@index([autoEcoleId])
  @@index([codeSuivi])
  @@index([autoEcoleId, statutInscription])
  @@index([moniteurId])
  @@index([vehiculeId])
  @@map("eleves")
}

/// Abonnement Web Push (navigateur) — app candidat PWA
model CandidatPushSubscription {
  id        String   @id @default(cuid())
  eleveId   String   @map("eleve_id")
  endpoint  String   @unique
  p256dh    String   @map("p256dh")
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  eleve Eleve @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  @@index([eleveId])
  @@map("candidat_push_subscriptions")
}

model ListeExamen {
  id                 String            @id @default(cuid())
  autoEcoleId        String            @map("auto_ecole_id")
  centreExamen       String            @map("centre_examen")
  wilaya             String
  dateDepot          DateTime          @map("date_depot") @db.Date
  dateExamen         DateTime          @map("date_examen") @db.Date
  inspecteurNom      String?           @map("inspecteur_nom")
  moniteur1Nom       String?           @map("moniteur1_nom")
  moniteur1Categorie String?           @map("moniteur1_categorie")
  moniteur2Nom       String?           @map("moniteur2_nom")
  moniteur2Categorie String?           @map("moniteur2_categorie")
  ecoleNomAr         String?           @map("ecole_nom_ar")
  ecoleAdresse       String?           @map("ecole_adresse")
  ecoleRegistre      String?           @map("ecole_registre")
  ecoleTelephone     String?           @map("ecole_telephone")
  referenceEnvoi     String?           @map("reference_envoi")
  lieuRedaction      String?           @map("lieu_redaction")
  statut             ListeExamenStatut @default(brouillon)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  autoEcole AutoEcole                       @relation(fields: [autoEcoleId], references: [id], onDelete: Cascade)
  candidats ListeExamenCandidat[]
  messagesCategorie ListeExamenMessageCategorie[]

  @@index([autoEcoleId])
  @@index([autoEcoleId, dateExamen])
  @@map("listes_examen")
}

/// Message optionnel par catégorie de permis sur une liste (A/A1 = une entrée par catégorie représentative)
model ListeExamenMessageCategorie {
  id                String   @id @default(cuid())
  listeExamenId     String   @map("liste_examen_id")
  categoriePermisId String   @map("categorie_permis_id")
  message           String?
  heureConvocation  String?  @map("heure_convocation")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  listeExamen     ListeExamen          @relation(fields: [listeExamenId], references: [id], onDelete: Cascade)
  categoriePermis CategoriePermisEcole @relation(fields: [categoriePermisId], references: [id], onDelete: Restrict)

  @@unique([listeExamenId, categoriePermisId])
  @@index([listeExamenId])
  @@map("liste_examen_messages_categorie")
}

model ListeExamenCandidat {
  id                String            @id @default(cuid())
  listeExamenId     String            @map("liste_examen_id")
  eleveId           String            @map("eleve_id")
  categoriePermisId String            @map("categorie_permis_id")
  ordre             Int
  natureExamen      NatureExamenListe @map("nature_examen")
  dateDernierExamen DateTime?         @map("date_dernier_examen") @db.Date
  /// Valeurs: present, absent_j, absent_nj, annule, rejete, ajourne, admis
  resultat          String?

  listeExamen     ListeExamen          @relation(fields: [listeExamenId], references: [id], onDelete: Cascade)
  eleve           Eleve                @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  categoriePermis CategoriePermisEcole @relation(fields: [categoriePermisId], references: [id], onDelete: Restrict)

  @@unique([listeExamenId, eleveId])
  @@unique([listeExamenId, categoriePermisId, ordre])
  @@index([listeExamenId])
  @@index([categoriePermisId])
  @@map("liste_examen_candidats")
}

model Moniteur {
  id               String            @id @default(cuid())
  autoEcoleId      String            @map("auto_ecole_id")
  nom              String
  prenom           String
  nomAr            String?           @map("nom_ar")
  prenomAr         String?           @map("prenom_ar")
  /// Catégorie principale (1re catégorie enseignée — compatibilité listes / filtres)
  categoriePermisId String?              @map("categorie_permis_id")
  /// Un seul moniteur principal par auto-école ; peut enseigner plusieurs catégories
  estPrincipal         Boolean              @default(false) @map("est_principal")
  telephone            String?
  /// Numéro de la carte professionnelle moniteur
  numeroCarteMoniteur  String?              @map("numero_carte_moniteur")
  /// Date de fin du contrat (alerte à J-15)
  dateFinContrat       DateTime?            @map("date_fin_contrat") @db.Date
  actif                Boolean              @default(true)
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  autoEcole            AutoEcole                 @relation(fields: [autoEcoleId], references: [id], onDelete: Cascade)
  categoriePermis      CategoriePermisEcole?     @relation(fields: [categoriePermisId], references: [id], onDelete: SetNull)
  categoriesEnseignees MoniteurCategoriePermis[]
  paiements            Paiement[]
  seancesExamen        SeanceExamen[]
  eleves               Eleve[]

  @@index([autoEcoleId])
  @@map("moniteurs")
}

/// Catégories enseignées par un moniteur (plusieurs pour le moniteur principal)
model MoniteurCategoriePermis {
  moniteurId        String   @map("moniteur_id")
  categoriePermisId String   @map("categorie_permis_id")
  createdAt         DateTime @default(now()) @map("created_at")

  moniteur        Moniteur             @relation(fields: [moniteurId], references: [id], onDelete: Cascade)
  categoriePermis CategoriePermisEcole @relation(fields: [categoriePermisId], references: [id], onDelete: Cascade)

  @@id([moniteurId, categoriePermisId])
  @@index([categoriePermisId])
  @@map("moniteur_categories_permis")
}

enum VehicleType {
  voiture
  moto
  bus
  camion
}

model Vehicule {
  id                         String      @id @default(cuid())
  autoEcoleId                String      @map("auto_ecole_id")
  type                       VehicleType
  marque                     String
  modele                     String
  matricule                  String?
  assuranceExpiration        DateTime?   @map("assurance_expiration")
  controleTechniqueExpiration DateTime?  @map("controle_technique_expiration")
  createdAt                  DateTime    @default(now()) @map("created_at")
  updatedAt                  DateTime    @updatedAt @map("updated_at")

  autoEcole     AutoEcole      @relation(fields: [autoEcoleId], references: [id], onDelete: Cascade)
  seancesExamen SeanceExamen[]
  eleves        Eleve[]

  @@index([autoEcoleId])
  @@map("vehicules")
}

model Paiement {
  id              String   @id @default(cuid())
  autoEcoleId     String   @map("auto_ecole_id")
  eleveId         String   @map("eleve_id")
  moniteurId      String?  @map("moniteur_id")
  montant         Int
  moniteurNom     String   @map("moniteur_nom")
  enregistreParId String?  @map("enregistre_par_id")
  createdAt       DateTime @default(now()) @map("created_at")

  autoEcole     AutoEcole @relation(fields: [autoEcoleId], references: [id], onDelete: Cascade)
  eleve         Eleve     @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  moniteur      Moniteur? @relation(fields: [moniteurId], references: [id], onDelete: SetNull)
  enregistrePar User?     @relation("PaiementEnregistrePar", fields: [enregistreParId], references: [id], onDelete: SetNull)

  @@index([autoEcoleId])
  @@index([eleveId])
  @@map("paiements")
}

/// Séance planifiée (code, créneau, circulation ou examen) — 20 min minimum entre deux séances
model SeanceExamen {
  id          String       @id @default(cuid())
  autoEcoleId String       @map("auto_ecole_id")
  eleveId     String       @map("eleve_id")
  moniteurId  String?      @map("moniteur_id")
  vehiculeId  String?      @map("vehicule_id")
  type        SeanceType   @default(code)
  dateHeure   DateTime     @map("date_heure")
  statut           SeanceStatut @default(planifie)
  notes            String?
  messageCandidat  String?      @map("message_candidat")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  autoEcole AutoEcole @relation(fields: [autoEcoleId], references: [id], onDelete: Cascade)
  eleve     Eleve     @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  moniteur  Moniteur? @relation(fields: [moniteurId], references: [id], onDelete: SetNull)
  vehicule  Vehicule? @relation(fields: [vehiculeId], references: [id], onDelete: SetNull)

  @@index([autoEcoleId])
  @@index([autoEcoleId, dateHeure])
  @@index([vehiculeId, dateHeure])
  @@map("seances_examen")
}

/// Réponse candidat (accepter / refuser) pour une séance ou une convocation examen
model CandidatEngagement {
  id           String                   @id @default(cuid())
  autoEcoleId  String                   @map("auto_ecole_id")
  eleveId      String                   @map("eleve_id")
  type         CandidatEngagementType
  referenceId  String                   @map("reference_id")
  statut       CandidatEngagementStatut @default(en_attente)
  motif        String?
  reponduAt    DateTime?                @map("repondu_at")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  autoEcole AutoEcole @relation(fields: [autoEcoleId], references: [id], onDelete: Cascade)
  eleve     Eleve     @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  @@unique([type, referenceId])
  @@index([eleveId])
  @@index([autoEcoleId])
  @@map("candidat_engagements")
}

// ——— Apprentissage (contenu public — texte en BDD, images dans public/) ———

model LearningModule {
  id              String   @id @default(cuid())
  slug            String   @unique
  step            Int
  titleFr         String   @map("title_fr")
  titleKab        String?  @map("title_kab")
  subtitleFr      String?  @map("subtitle_fr")
  subtitleKab     String?  @map("subtitle_kab")
  descriptionFr   String?  @map("description_fr") @db.Text
  descriptionKab  String?  @map("description_kab") @db.Text
  unlockAfterSlug String?  @map("unlock_after_slug")
  published       Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  chapters LearningChapter[]

  @@map("learning_modules")
}

model LearningChapter {
  id         String   @id @default(cuid())
  moduleId   String   @map("module_id")
  slug       String
  sortOrder  Int      @map("sort_order")
  titleFr    String   @map("title_fr")
  titleKab   String?  @map("title_kab")
  summaryFr  String?  @map("summary_fr") @db.Text
  summaryKab String?  @map("summary_kab") @db.Text
  bodyFr     String?  @map("body_fr") @db.Text
  bodyKab    String?  @map("body_kab") @db.Text
  /// [{ src, altFr, altKab?, captionFr?, captionKab?, sortOrder }]
  imagesJson Json     @default("[]") @map("images_json")
  published  Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  module LearningModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, slug])
  @@index([moduleId, sortOrder])
  @@map("learning_chapters")
}
