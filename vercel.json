{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "prisma generate && npm run build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["cdg1"],
  "functions": {
    "app/api/v1/eleves/[id]/fiche-avancement/pdf/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/v1/listes-examen/[id]/pdf/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
