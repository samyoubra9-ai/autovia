# =============================================================================
# Autovia — modèle .env (copier vers .env, remplir les secrets, ne pas committer .env)
#
# PRODUCTION : bloc « PROD » ci-dessous → Vercel (racine Next.js)
# DEV LOCAL  : bloc « DEV » commenté → puis npm run env:sync
# =============================================================================


# =============================================================================
# PRODUCTION — autovia.space (Vercel + Supabase)
# Copier ce bloc dans le dashboard Vercel (projet Next.js, racine du repo).
# Pour backdash / candidat / platform-admin : voir backdash/.env.example
# =============================================================================

# --- Secrets (Supabase → Settings → API / Database) ---
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# --- URLs (source : modifier PUBLIC_* puis npm run env:sync en local) ---
# Important : autovia.space redirige vers www — l’API utilise www pour CORS / PWA.
PUBLIC_SCHEME=https
PUBLIC_APP_HOST=www.autovia.space
PUBLIC_BACKDASH_HOST=app.autovia.space
PUBLIC_CANDIDAT_HOST=candidat.autovia.space
PUBLIC_PLATFORM_ADMIN_HOST=admin.autovia.space
ALLOW_DEV_LAN_ORIGINS=false
CORS_EXTRA_ORIGINS=https://autovia.space,https://www.autovia.space

# --- Généré par npm run env:sync (à recopier tel quel sur Vercel si besoin) ---
NEXT_PUBLIC_APP_URL=https://www.autovia.space
NEXT_PUBLIC_BACKDASH_URL=https://app.autovia.space
NEXT_PUBLIC_CANDIDAT_URL=https://candidat.autovia.space
NEXT_PUBLIC_PLATFORM_ADMIN_URL=https://admin.autovia.space

# Web Push candidat (npm run push:generate-vapid) — projet API uniquement
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@autovia.space

# Supabase Auth → Site URL = https://app.autovia.space
# Redirect URLs :
#   https://app.autovia.space/auth/callback
#   https://admin.autovia.space/auth/callback
#   https://www.autovia.space/auth/callback

# DNS / Vercel :
#   www.autovia.space (ou autovia.space) → Next.js (API + landing)
#   app.autovia.space                   → backdash
#   candidat.autovia.space              → candidat (PWA)
#   admin.autovia.space                 → platform-admin


# =============================================================================
# DEV LOCAL — Wi‑Fi / PC (décommenter, commenter le bloc PROD ci-dessus)
# =============================================================================
# PUBLIC_SCHEME=http
# PUBLIC_APP_HOST=192.168.43.157
# PUBLIC_BACKDASH_HOST=
# ALLOW_DEV_LAN_ORIGINS=true
# CORS_EXTRA_ORIGINS=
# Puis : npm run env:sync
#
# NEXT_PUBLIC_* seront par ex. :
#   http://192.168.43.157:3000  (Next)
#   http://192.168.43.157:5173  (backdash)
# Supabase Auth (dev) : Site URL = http://VOTRE_IP:5173

# Une fois : https://www.autovia.space/setup-admin (compte propriétaire), puis retirer la route
