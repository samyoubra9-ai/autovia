# =============================================================================
# Autovia — variables d'environnement (copier vers .env)
# URLs : voir env.urls.example (même bloc à recopier dans backdash / candidat / platform-admin)
# =============================================================================

# Prisma — pooler Supabase (IPv4), port 6543
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma — migrations
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres"

# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"

# Supabase → Settings → API → service_role (secret, serveur uniquement)
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# --- URLs publiques (CORS, redirections OAuth, liens QR suivi) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Landing : Connexion / Démarrer → cette URL + /sign-in (voir getBackdashSignInUrl)
NEXT_PUBLIC_BACKDASH_URL="http://localhost:5173"
NEXT_PUBLIC_CANDIDAT_URL="http://localhost:5174"
NEXT_PUBLIC_PLATFORM_ADMIN_URL="http://localhost:5175"
CORS_EXTRA_ORIGINS=
ALLOW_DEV_LAN_ORIGINS=true

# backdash/.env, candidat/.env, platform-admin/.env : copier env.urls.example (VITE_* + Supabase)

# Supabase Auth → Site URL = NEXT_PUBLIC_BACKDASH_URL, Redirect = …/auth/callback

# En dev : désactiver la confirmation e-mail dans Supabase Auth → Providers → Email

# Une fois : NEXT_PUBLIC_APP_URL/setup-admin pour le compte propriétaire, puis retirer la route
