{
  "name": "autoecole",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "supabase:generate-types": "supabase gen types typescript --linked > types/supabase.ts",
    "env:sync": "node scripts/sync-env-urls.mjs",
    "brand:sync": "node scripts/sync-brand-icons.mjs",
    "push:generate-vapid": "node scripts/generate-vapid-keys.mjs",
    "build:all": "npm run build && npm run build --prefix backdash && npm run build --prefix candidat && npm run build --prefix platform-admin",
    "db:sql:moniteur-principal": "node -e \"console.log('Exécuter docs/sql/moniteur-principal-prod.sql dans Supabase SQL Editor (prod).')\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.105.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.4",
    "supabase": "^2.98.2",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
